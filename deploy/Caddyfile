# HTTPS certificates are requested and renewed by Caddy (Let's Encrypt) once the domain points to this server.
{
	# a shop's own domain (myshop.com): its certificate is asked for at its first visit, only when the server says the
	# domain belongs to an active shop and points here (Shop › Lien des pages › Domaine)
	on_demand_tls {
		ask http://server:3000/api/domain-check
	}
	# the visitor's own address. A request that comes from Cloudflare (its addresses: https://www.cloudflare.com/ips/)
	# carries it in CF-Connecting-IP, written by Cloudflare; any other caller (the backup door, a shop's domain without
	# Cloudflare) is taken at the address that connected, so no visitor can choose the address the server sees
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# The Pilotix server (API, webhooks, landing pages, live updates). It is told the visitor's address found above (the
# login limit, the landing pages' checks and the ads' conversions use it), and the address and scheme as Caddy got
# them: what a visitor writes in X-Forwarded-* never reaches it.
(server) {
	reverse_proxy server:3000 {
		header_up X-Forwarded-For {client_ip}
		header_up X-Forwarded-Host {hostport}
		header_up X-Forwarded-Proto {scheme}
	}
}

# The platform's site (the app, its server, the shops' pages): the same at its own address and at the backup door.
(platform) {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(self), camera=(self)"
		-Server
	}
	# the app cannot be shown inside another site's frame (clickjacking); landing pages (/api/lp) can
	@app not path /api/lp/*
	header @app X-Frame-Options "DENY"

	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	# the Pilotix server: API, webhooks, landing pages, live updates
	handle /api/* {
		import server
	}
	handle /live* {
		import server
	}

	# the terms and privacy page is the app's /conditions (Google and Facebook sign-in ask for it); its other names lead there
	@legal path /confidentialite /confidentialite/ /privacy /privacy/ /terms /terms/
	redir @legal /conditions 301

	# a product's page as customers see it: site/<store>/<page> (the app's own files all have a dot: never matched).
	# Not the app's own addresses: pilotix.online/<store>/<app page> (a boutique's « Commandes », « Suivi »…) and the
	# pages that belong to no boutique (/conditions, /reset/<secret>…). These two lists are APP_PAGES and PUBLIC_ROOTS
	# in packages/shared/src/links.ts (a test checks they are the same); no store and no landing page takes these words.
	@store {
		path_regexp page ^/([a-z0-9-]{2,40})/([a-z0-9-]{2,60})/?$
		not path /api/* /live*
		not path_regexp ^/(?:conditions|pro|platform|reset|invite|signup|verify|inscription|inscription-agence|inscription-marketer|confirmer)/|^/[a-z0-9-]+/(?:accueil|dashboard|commandes|livrees|retournees|confirmation|depot|scanner|produits|suivi|sav|tournee|clients|messages|cm|social|createur|notify|comptes|marketing|landing|caisse|macaisse|pos|livraison|utilisateurs|management|reglages|agences|marketers|influenceurs|profil|boutiques|aide|analyse|vendeurs|facturation|affectation|comptepro|gains|partenaires|pilotai|livreurs|publicite|marketer|spy|equipe|tarifs|adsets)/?$
	}
	handle @store {
		rewrite * /api/s/{re.page.1}/{re.page.2}
		import server
	}

	# for AI assistants: the shop and its landing pages (made by the server); no ai-catalog.json (a 404, not the app's page)
	handle /llms.txt {
		rewrite * /api/llms.txt
		import server
	}
	handle /ai-catalog.json {
		respond 404
	}
	handle /.well-known/ai-catalog.json {
		respond 404
	}

	# the app. Its pages run only Pilotix's own scripts (and Google's sign-in, and Cloudflare's robot check after a few
	# wrong passwords: apps/web/src/lib/robot.ts): a script slipped into a page by someone
	# never runs, never loads from elsewhere, and the app is never shown inside another site. Checked on every page of
	# the app with the policy on (no page needed more). The landing pages (/api/…) have their own rules.
	# Meta's script (connect.facebook.net) and its frames (*.facebook.com): « Connecter WhatsApp » opens Meta's own
	# popup (Embedded Signup), the way Meta asks it to be opened.
	handle {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://accounts.google.com/gsi/client https://challenges.cloudflare.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' blob: https://accounts.google.com https://challenges.cloudflare.com https://*.facebook.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN}, www.{$DOMAIN} {
	import platform
}

# The backup door: the same site at direct.<domain>, reached WITHOUT Cloudflare (its DNS record is « DNS only »,
# pointing straight here), for when Cloudflare's road from a country is cut. The app opened there talks to that same
# address (apps/web backend.ts › BACKUP_DOOR). Its certificate is asked for at its first visit (the server allows it).
direct.{$DOMAIN} {
	tls {
		on_demand
	}
	import platform
}

# The landing pages' own address: go.<domain>/<store>/<page>, the links in the ads. Only the pages and what they call
# live here (their order and lead forms, communes, photos, the lists for AI assistants): not the app, not its login,
# not its other doors, so nothing a page runs can reach a team's session. The server sends the old addresses
# (<domain>/<store>/<page>, /api/lp/<page>) here once this name answers it (LANDING_URL, /api/landing-ready). Its
# certificate is asked for at its first visit (the server allows that one name, domain-check).
go.{$DOMAIN} {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
		-Server
	}
	# what a page calls: /api/lp/… (shop #1), /api/s/<store>/lp/… (the others), the server's own check
	@pageapi path_regexp ^/api/(?:lp/|s/[a-z0-9-]{2,40}/lp/|landing-ready$|llms\.txt$|s/[a-z0-9-]{2,40}/llms\.txt$)
	handle @pageapi {
		import server
	}
	# a page: go.<domain>/<store>/<page> (a group of pages too)
	@page path_regexp page ^/([a-z0-9-]{2,40})/([a-z0-9-]{2,60})/?$
	handle @page {
		rewrite * /api/s/{re.page.1}/{re.page.2}
		import server
	}
	handle /llms.txt {
		rewrite * /api/llms.txt
		import server
	}
	# the planned posts' photos and videos, and the product photos Dellal sends, stay open to robots: Meta fetches them
	# from there (a story's video is refused from a site whose robots.txt closes it)
	handle /robots.txt {
		respond "User-agent: *
Allow: /
Allow: /api/lp/pic/
Allow: /api/lp/vid/
Allow: /api/lp/dp/
Disallow: /api/
" 200
	}
	# anything else (the home, the app's addresses, its server): the platform's site, which decides
	handle {
		redir https://{$DOMAIN}{uri} 302
	}
}

# A shop's own domain: its landing pages (https://myshop.com/<page>; the server finds the shop by the name asked for).
# The pages call /api on that same domain.
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	handle /api/* {
		import server
	}
	handle / {
		rewrite * /api/domain
		import server
	}
	handle {
		rewrite * /api/domain{path}
		import server
	}
}

# any other name asked for in plain HTTP: the same address in HTTPS
http:// {
	redir https://{host}{uri} permanent
}
