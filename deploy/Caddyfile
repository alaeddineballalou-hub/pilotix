# HTTPS certificates are requested and renewed by Caddy (Let's Encrypt) once the domain points to this server.
{$DOMAIN}, www.{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(self), camera=(self)"
		-Server
	}
	# the app cannot be shown inside another site's frame (clickjacking); landing pages (/api/lp) can
	@app not path /api/lp/*
	header @app X-Frame-Options "DENY"

	@www host www.{$DOMAIN}
	redir @www https://{$DOMAIN}{uri} permanent

	# the Pilotix server: API, webhooks, landing pages, live updates
	handle /api/* {
		reverse_proxy server:3000
	}
	handle /live* {
		reverse_proxy server:3000
	}

	# a product's page as customers see it: site/<store>/<page> (the app's own files all have a dot: never matched)
	@store {
		path_regexp page ^/([a-z0-9-]{2,40})/([a-z0-9-]{2,60})/?$
		not path /api/* /live*
	}
	handle @store {
		rewrite * /api/s/{re.page.1}/{re.page.2}
		reverse_proxy server:3000
	}

	# for AI assistants: the shop and its landing pages (made by the server); no ai-catalog.json (a 404, not the app's page)
	handle /llms.txt {
		rewrite * /api/llms.txt
		reverse_proxy server:3000
	}
	handle /ai-catalog.json {
		respond 404
	}
	handle /.well-known/ai-catalog.json {
		respond 404
	}

	# the app
	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
