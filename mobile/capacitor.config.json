{
  "appId": "com.pilotix.app",
  "appName": "Pilotix",
  "webDir": "www",
  "backgroundColor": "#1B2A47",
  "appendUserAgent": "PilotixApp",
  "server": {
    "allowNavigation": [
      "pilotix.online",
      "direct.pilotix.online"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 200,
      "launchAutoHide": true,
      "launchFadeOutDuration": 150,
      "backgroundColor": "#1B2A47",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "DARK"
    }
  }
}
