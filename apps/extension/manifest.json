{
  "manifest_version": 3,
  "name": "Pilotix Spy",
  "version": "1.0.0",
  "description": "Trouve les pubs Facebook de vos concurrents dans la bibliothèque publicitaire publique, pour la page AI Spy de votre Pilotix.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pilotix Spy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://*.fbcdn.net/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
