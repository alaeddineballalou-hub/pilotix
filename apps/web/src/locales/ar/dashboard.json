  "help": {
    "headAll": "ترى كل الفرق. اختر في الأسفل ما يديره كل مسؤول: لن يرى إلا هذه الألسنة.",
    "headMine": "ترى فريقك: أعوانك وأنت.",
    "depot": "الطرود في كل مرحلة من المستودع الآن، وما خرج خلال الفترة.",
    "suivi": "الطرود عند شركات التوصيل والموصّلين: تنبيهات للمعالجة، المُسلَّمة والمُرجعة خلال الفترة.",
    "sav": "تذاكر خدمة ما بعد البيع: في الانتظار، قيد المعالجة، والمسوّاة خلال الفترة.",
    "received": "الطلبات المُنشأة خلال الفترة والمسندة لأعوان الفريق. في الأسفل: التي ما زالت في حالة اتصال (جديدة، للتحقق، لا رد، مشغول، معاودة الاتصال، مؤجلة).",
    "confirmed": "الطلبات المؤكدة (أو المؤكدة بدون مخزون) من طلبات المربع الأول. في الأسفل: كل التأكيدات خلال الفترة، بما فيها الطلبات الأقدم.",
    "confRate": "النسبة: المؤكدة ÷ كل الطلبات. أحمر تحت 50 %، أصفر من 50 إلى 59 %، أخضر من 60 %. في الأسفل: الملغاة، المزيفة (طلب مزيف أو رقم خاطئ) والمكررة.",
    "confRatePerf": "الأداء: المؤكدة ÷ الطلبات، بدون المكررة والأرقام الخاطئة، فقط على الطلبات ذات النتيجة المعروفة (أو الأقدم من 15 يوما). أحمر تحت 50 %، أصفر من 50 إلى 59 %، أخضر من 60 %.",
    "delivRate": "النسبة: المُسلَّمة ÷ المؤكدة، كل الطلبات المؤكدة.",
    "finalRate": "النسبة: المُسلَّمة ÷ كل الطلبات.",
    "inProgress": "طلبات أعوان الفريق التي ما زالت للاتصال الآن: جديدة، للتحقق، لا رد، مشغول، معاودة الاتصال، مؤجلة. رقم اليوم، لا يتغير مع الفترة. في الأسفل: الطلبات الجديدة في كل المتجر بدون عون بعد.",
    "late": "طلبات « معاودة الاتصال » أو « مؤجلة » التي مرّ موعدها بدون اتصال جديد. تُحسب الآن، وليس خلال الفترة.",
    "first": "نسبة الطلبات التي تم الاتصال بها أول مرة قبل موعدها. يبدأ العدّ عند أول إسناد لعون. آخر وارد أول من يُتصل به: الأحدث له 15 دقيقة، وكل طلب أقدم 5 دقائق إضافية لكل طلب أحدث قبله. طلبات الليل (بعد 21 سا) تُحسب من 9 سا. أحمر تحت 70 %، أصفر من 70 إلى 79 %، أخضر من 80 %.",
    "tries": "بعد « لا رد » أو « مشغول »، يجب أن تكون المحاولة التالية في الفترة الموالية: صباحا 9–12، منتصف النهار 12–16، مساء 16–21. 3 محاولات كحد أقصى. نسبة المحاولات في وقتها، تُحسب للعون الذي قام بالاتصال بدون رد. أحمر تحت 70 %، أصفر من 70 إلى 79 %، أخضر من 80 %.",
    "calls": "كل تغيير لحالة التأكيد يقوم به عون خلال الفترة يُحسب كاتصال. في الأسفل: عدد الاتصالات في المتوسط لكل تأكيد."
  },
