{
  "manifest_version": 3,
  "name": "Pilotix WhatsApp",
  "version": "1.0.0",
  "description": "Pilotix › Envoyer des photos : ouvre la discussion WhatsApp Web du client et y colle les vraies photos des produits avec le message.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://pilotix.online/*", "https://direct.pilotix.online/*"],
      "js": ["pilotix.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["https://web.whatsapp.com/*", "https://pilotix.online/*", "https://direct.pilotix.online/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
