# Copy to .env and change every value before going to production.
PORT=3000
DATABASE_URL=postgres://pilotix:pilotix_dev_only@localhost:5432/pilotix
REDIS_URL=redis://localhost:6379
# Long random string (at least 32 characters). Never commit the real one. The server refuses this example value
# in production. Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES=12h
# Sites allowed to call the API (the website address, plus the phone apps).
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost
# Behind a reverse proxy (nginx, Caddy, a load balancer): 1. Leave empty when the server is reached directly.
TRUST_PROXY=
# Public address of this server, shown in webhook URLs.
PUBLIC_URL=http://localhost:3000
# Used once by "npm run seed -w @pilotix/server" to create the first admin.
SEED_ADMIN_EMAIL=admin@pilotix.dz
SEED_ADMIN_PASSWORD=
# E-mails ("mot de passe oublié"). Leave SMTP_HOST empty to hide the link. Examples:
#   Gmail:          smtp.gmail.com, 465, your Gmail address, an app password (Google account > Security > App passwords)
#   Microsoft 365:  smtp.office365.com, 587, the mailbox address, its password (SMTP AUTH must be on for the mailbox)
#   Brevo:          smtp-relay.brevo.com, 587, the SMTP login and key shown in Brevo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pilotix <contact@your-shop.dz>"
